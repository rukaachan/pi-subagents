{
	"name": "@rukaachan/pi-subagents",
	"version": "0.1.0",
	"private": true,
	"description": "Reusable subagents for Pi coding agent: fresh-context Task delegation with own prompt, model, and tool policy.",
	"keywords": [
		"pi",
		"pi-package",
		"subagents"
	],
	"homepage": "https://github.com/rukaachan/pi-subagents#readme",
	"license": "MIT",
	"author": "rukaachan",
	"repository": {
		"type": "git",
		"url": "https://github.com/rukaachan/pi-subagents"
	},
	"type": "module",
	"scripts": {
		"test": "node --experimental-strip-types --test tests/*.test.ts",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint -D correctness -D suspicious",
		"lint:fix": "oxlint -D correctness -D suspicious --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"check": "npm run format:check && npm run lint && npm run typecheck && npm test",
		"arch": "node --experimental-strip-types --test tests/architecture.test.ts",
		"clean": "rm -rf node_modules"
	},
	"devDependencies": {
		"@earendil-works/pi-agent-core": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@earendil-works/pi-tui": "1.4.0",
		"@types/node": "22.19.19",
		"oxfmt": "^0.68.0",
		"oxlint": "^1.83.0",
		"typebox": "^1.3.27",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-agent-core": {
			"optional": true
		},
		"@earendil-works/pi-ai": {
			"optional": true
		},
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@earendil-works/pi-tui": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"pi": {
		"extensions": [
			"./extensions/index.ts"
		]
	}
}
